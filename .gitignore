# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# PyInstaller temporary / build artifacts
*.manifest
*.spec.bak

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Environments & virtualenvs
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# Credential material (defense in depth)
*.pem
*.key
*.p12
*.pfx

# User data & local databases
data/
*.db
*.sqlite
*.sqlite3

# Local runtime settings & secrets (use settings.example.json instead)
settings.json
*.local.json
secrets.json
tests/temp_settings.json

# IDE and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs and crash dumps
*.log
*.dump
*.dmp
